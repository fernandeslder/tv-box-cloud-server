[Unit]
Description=Drain AI queue (singleton - overlapping runs exit quietly)
After=network-online.target docker.service
Wants=network-online.target
ConditionPathIsMountPoint=@POOL@

[Service]
RuntimeDirectory=tvbox
RuntimeDirectoryPreserve=yes
Type=oneshot
User=@USER@
Group=www-data
UMask=0002
Environment="LEGION_HOSTS=legion-linux legion-win"
ExecStart=/usr/bin/flock -n /run/tvbox/ai-queue.lock @REPO@/scripts/ai-queue.sh
