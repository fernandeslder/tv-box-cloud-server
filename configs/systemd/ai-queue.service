[Unit]
Description=Drain AI queue every 5 minutes (singleton — overlapping runs exit quietly)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=htpc
Environment="LEGION_HOSTS=legion-linux legion-win"
ExecStart=/usr/bin/flock -n /tmp/ai-queue.lock /home/htpc/tv-box-cloud-server/scripts/ai-queue.sh
