[Unit]
Description=Drain the upload inbox into sorted folders
ConditionPathIsMountPoint=@POOL@
After=tvbox-storage.service

[Service]
Type=oneshot
User=@USER@
Group=www-data
UMask=0002
WorkingDirectory=@REPO@/scripts
ExecStart=/usr/bin/flock -n /run/lock/tvbox-ingest.lock @REPO@/scripts/ingest.sh @POOL@/inbox
