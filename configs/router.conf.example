# router.conf — escalation policy. Copied to configs/router.conf (mode 600) by setup. NEVER commit the real one.
#
# Ladder: local rules -> your Legion (Jev/qwen, unredacted: it is yours) -> EXTERNAL (Command Code
# Provider API) only for CLEAN verdicts the Legion is unsure about. Everything sent externally is
# REDACTED first and capped at ~4KB of transcript — never a file. SECRET verdicts never leave.
#
# The external step climbs "intelligence tiers" only as far as needed:
#   jev    typesafe/jev System One decision model (typed, calibrated, cheap)        [if CC_USE_JEV=true]
#   free   $0 models (laguna, ling, space-bunny)
#   value  cheap + smart (deepseek, glm, mimo, kimi, muse)
#   strong bigger models, only if EXTERNAL_MAX_TIER=strong
# It stops at the first answer with confidence >= ROUTER_CONFIDENCE_MIN.

COMMAND_CODE_API_KEY=

# Master switch (still needs a key). Free + jev + value all respect the monthly cap below.
EXTERNAL_ENABLED=true
EXTERNAL_MAX_TIER=value          # free | value | strong
EXTERNAL_MONTHLY_CAP_USD=2.00
ROUTER_CONFIDENCE_MIN=70
CC_USE_JEV=true
CC_ZDR=0                         # 1 = zero data retention (models without a ZDR upstream will 422 and be skipped)

# Model lists, best-first. price-check.sh drops any id that vanished from the live catalogue.
CC_FREE_MODELS="poolside/laguna-s-2.1-free inclusionai/ling-3.1-flash:free stealth/space-bunny-alpha"
CC_VALUE_MODELS="deepseek/deepseek-v4.1-flash z-ai/glm-5.3-flash xiaomi/mimo-v2.5 meta/muse-spark-1.2-contributor moonshotai/Kimi-K3"
CC_STRONG_MODELS="deepseek/deepseek-v4-pro MiniMaxAI/MiniMax-M3 zai-org/GLM-5.3"

# Booked per call for the monthly cap (rough, per ~1K tokens in / 50 out). Tune from your Command Code usage page.
CC_EST_JEV=0.0001
CC_EST_VALUE=0.0005
CC_EST_STRONG=0.004

# Legion System-1 fallback (see jev.sh): TV-box-local Ollama running a small decision model.
JEV_FALLBACK_URL=http://localhost:11434
JEV_FALLBACK_MODEL=
