TZ=Europe/London
PUID=1000
PGID=1000
STORAGE_ROOT=/mnt/pool
CACHE_ROOT=/mnt/cache

# --- net ---
PIHOLE_PASS=change-me-first
CADDY_DOMAIN=home.lan
CADDY_LAN_IP=192.168.2.10
# Pair with the Beszel hub UI once (metrics.<domain> -> Add System), then fill in.
# BESZEL_KEY=
# BESZEL_TOKEN=

# --- cloud ---
# Pin Immich server + laptop ML to the SAME version number (e.g. v2.4.1), never :release.
# Check current: ghcr.io/immich-app/immich-server tags.
IMMICH_VERSION=v2.4.1
IMMICH_DB_PASSWORD=change-me-immich-db
IMMICH_DB_USER=immich
IMMICH_DB_NAME=immich
# Separate password for Nextcloud's own database (do NOT reuse the Immich one).
NEXTCLOUD_DB_PASSWORD=change-me-nextcloud-db
# STORAGE_DISK1_UUID=xxxx  # blkid, used by scripts/40-storage.sh
# STORAGE_DISK2_UUID=xxxx

# --- media/torrent (opt-in) ---
# VPN_PROVIDER=protonvpn  # gluetun provider (see https://github.com/qdm12/gluetun-wiki)
# WG_PRIVATE_KEY=xxxx      # WireGuard private key from your VPN provider; required to start gluetun
# GLUETUN_SUBNETS=192.168.0.0/24,100.64.0.0/10  # LAN + Tailscale reachable from behind the VPN;
#                                               # ADJUST 192.168.x.0/24 to your real LAN

# --- laptop (ml-laptop/compose.yml runs on the 12GB VRAM machine, NOT tvbox) ---
# LAPTOP_TAILNET_IP=100.x.y.z
