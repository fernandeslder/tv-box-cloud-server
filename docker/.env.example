# docker/.env — normally GENERATED by `sudo ./setup.sh`. You rarely need to edit it.
# Every value here has a safe default or is generated; secrets are random.
# Never commit the real file (it is git-ignored).

# --- identity / paths -------------------------------------------------------
TZ=Europe/London
PUID=1000
PGID=1000
TVBOX_HOSTNAME=tvbox
TVBOX_DESKTOP=yes          # yes = Plasma + Kodi on the TV, no = headless server
TVBOX_FIREWALL=yes         # ufw: private LAN + Tailscale only
STORAGE_ROOT=/mnt/pool     # the one merged folder every app uses (SSD landing + USB HDDs)
CACHE_ROOT=/mnt/cache      # NVMe: databases, thumbnails, and landing/ (the upload cache)

# --- network / HTTPS --------------------------------------------------------
DOMAIN=home.lan            # your Cloudflare domain (e.g. example.com) or home.lan for LAN-only
LAN_IP=192.168.1.10        # auto-detected; reserve it in your router
LAN_CIDR=192.168.1.0/24
TLS_MODE=internal          # internal = local CA (install root.crt once) | cloudflare = trusted certs
CF_API_TOKEN=              # Cloudflare token: Zone:DNS:Edit + Zone:Zone:Read (+ Account:Cloudflare Tunnel:Edit for public sharing)
CF_TUNNEL_TOKEN=           # written by scripts/cloudflare.sh
PUBLIC_HOSTS="files photos"  # which subdomains the tunnel exposes (share links / shared albums only)
TAILSCALE_AUTHKEY=         # optional: unattended login (tailscale admin > Keys)
COMPOSE_PROFILES=media     # comma list: media,docs,torrent,public,agent

# --- secrets (generated) ----------------------------------------------------
PIHOLE_PASS=
IMMICH_DB_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
IMMICH_ADMIN_EMAIL=admin@home.lan
IMMICH_ADMIN_PASSWORD=
SMB_PASSWORD=

# --- cloud ------------------------------------------------------------------
# Server and Legion ML versions MUST match. Never :release.
IMMICH_VERSION=v3.2.4
# IMMICH_ML_URL=http://legion-linux:3003    # use the Legion's GPU for faces/search when it is online

# --- documents (profile "docs": Paperless-ngx) -------------------------------
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=   # generated
PAPERLESS_SECRET_KEY=       # generated

# --- laptop chassis ----------------------------------------------------------
BATTERY_MAX_CHARGE=80      # % cap while on mains 24/7 (ThinkPad-class laptops); 100 = off

# --- SSD cache policy (scripts/mover.sh) ------------------------------------
LANDING_MIN_FREE=20G       # SSD floor: uploads stop landing on the SSD below this
MOVER_MIN_AGE_MIN=15       # a file must be untouched this long before moving to the HDD
MOVER_KEEP_DAYS=3          # keep recent files on the SSD as a read cache
MOVER_HIGH_PCT=70          # SSD used% that forces draining
MOVER_LOW_PCT=50           # ...until the SSD is back under this

# --- media (profile "media") ------------------------------------------------
VIDEO_GID=44               # `getent group video` / `render` (detected by setup)
RENDER_GID=105

# --- torrent (profile "torrent"; needs a VPN) -------------------------------
# VPN_PROVIDER=protonvpn
# WG_PRIVATE_KEY=
# GLUETUN_SUBNETS=

# --- metrics (profile "agent") ----------------------------------------------
# BESZEL_KEY=
# BESZEL_TOKEN=

# --- backup -----------------------------------------------------------------
# BACKUP_INCLUDE="Photos Documents private Recordings Other immich nextcloud-data paperless"
# VERIFY_SAMPLE=20         # files restored + compared by the weekly restore test
# VERIFY_DATA_PCT=5        # % of backup blobs re-read by the weekly integrity check
# NTFY_URL=https://ntfy.sh/your-secret-topic   # optional push alerts for failures
