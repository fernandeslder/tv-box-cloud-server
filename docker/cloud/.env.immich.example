# Immich server env. Secrets come from docker/.env, never committed.
# DB_PASSWORD supports ${...} interpolation via compose env_file? No — env_file
# does NOT interpolate. scripts/install.sh renders this file from the example,
# substituting the real values. Do not hand-edit the rendered file.
DB_HOSTNAME=postgres
DB_USERNAME=${IMMICH_DB_USER:-immich}
DB_DATABASE_NAME=${IMMICH_DB_NAME:-immich}
DB_PASSWORD=${IMMICH_DB_PASSWORD:?set IMMICH_DB_PASSWORD in docker/.env}
REDIS_HOSTNAME=redis
UPLOAD_LOCATION=/data
IMMICH_VERSION=${IMMICH_VERSION:?set IMMICH_VERSION in docker/.env (e.g. v2.4.1)}
